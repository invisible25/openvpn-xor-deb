#!/bin/sh
# Не перезапускаем сервис: scramble ещё не прописан в конфигах, рестарт был бы
# бессмысленным. Печатаем инструкцию по включению обфускации.
set -e
case "$1" in
  configure)
    cat <<'MSG'
==================================================================
 openvpn-xor установлен: /usr/sbin/openvpn теперь XOR-сборка
 (оригинал сохранён как /usr/sbin/openvpn.distrib).

 Чтобы включить обфускацию, добавьте ОДИНАКОВУЮ строку
   scramble obfuscate <ВАШ_КЛЮЧ>
 в /etc/openvpn/server/server.conf и в КАЖДЫЙ клиентский .ovpn,
 затем перезапустите сервер:
   systemctl restart openvpn-server@server

 Откат: apt remove openvpn-xor   (вернёт штатный openvpn)
==================================================================
MSG
    ;;
esac
exit 0
